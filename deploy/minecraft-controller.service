[Unit]
Description=Minecraft Server Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mc-controller
Group=mc-controller
WorkingDirectory=/opt/mc-server-controller
EnvironmentFile=/etc/mc-server-controller/environment
ExecStart=/usr/bin/java -Xms128M -Xmx384M -jar /opt/mc-server-controller/mc-server-controller.jar
Restart=on-failure
RestartSec=10
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
